fixtures.lua

# Generated by export-real.lua from the live SavedVariables. It is a real
# night's loot, so it carries real character names — including pug players who
# have nothing to do with this guild. The SCRIPT is committed and reproducible;
# its output is not.
#
# test/export.txt IS tracked, and this comment used to claim it "contains no
# real people". That was FALSE: it carried five real roster names, and a comment
# asserting a safety property it does not have is worse than no comment, because
# it stops anyone checking. The fixtures now use INVENTED names chosen to keep
# the multi-byte property the tests exist for — a name whose Lua # and
# JavaScript .length disagree — so the claim is true by construction rather than
# by assertion. Verified before the addon's source went to a public repo.
export-real.txt
